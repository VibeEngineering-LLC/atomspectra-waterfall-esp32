# Keep EMBED_FILES web assets as LF so Windows/WSL clones don't inflate
# firmware size (+CRLF) and break hash comparison (see issue #9).
web/** text eol=lf
demo/** text eol=lf
# gzip is binary; demo/** above would strip CR bytes and dirty every checkout
demo/*.gz binary
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf
